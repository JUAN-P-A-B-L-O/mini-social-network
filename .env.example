# Copy to .env and replace all placeholders with distinct local passwords.
POSTGRES_PASSWORD=replace-with-local-admin-password
POSTS_DB_PASSWORD=replace-with-local-posts-password
MEDIA_DB_PASSWORD=replace-with-local-media-password
POST_SERVICE_PORT=8081
MEDIA_SERVICE_PORT=8082

# Optional S3 configuration for media uploads.
AWS_REGION=
MEDIA_S3_BUCKET=
MEDIA_UPLOAD_MAX_BYTES=10485760
