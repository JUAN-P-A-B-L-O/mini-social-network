# Browser API paths. Keep them relative to use the Vite proxy.
VITE_POST_API_BASE_URL=/api/posts
VITE_MEDIA_API_BASE_URL=/api/media
VITE_MEDIA_UPLOAD_MAX_BYTES=10485760

# Vite proxy defaults. Override in .env.local when Compose publishes different ports.
POST_API_PROXY_TARGET=http://127.0.0.1:8081
MEDIA_API_PROXY_TARGET=http://127.0.0.1:8082
